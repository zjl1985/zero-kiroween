{
  "name": "midnight-meow",
  "private": true,
  "type": "module",
  "description": "猫猫守夜 / Midnight Meow — code-drawn papercraft night watch",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/build-site.mjs",
    "art:prepare": "python3 scripts/prepare-generated-village.py",
    "start": "python3 -m http.server 4173 --directory site",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
