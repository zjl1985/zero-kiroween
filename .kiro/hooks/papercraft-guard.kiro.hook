{
  "enabled": true,
  "name": "Isometric pixel art guard",
  "description": "When rendering, art def or UI styling files change, check the isometric pixel-art, reproducible asset and read-only renderer constraints.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/render/**/*.ts",
      "src/defs/**/*art.ts",
      "styles.css",
      "index.html"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A rendering, art or UI file changed. Check the edit against docs/iso-art-spec.md and AGENTS.md: keep one active 2:1 isometric pixel HD-2D style with no runtime style toggle; generated or code-authored pixel atlases must live in the repo with reproducible scripts and stay in the site build allowlist; painters read SimState only and never mutate sim state or consume sim RNG / Math.random; keep Allo font licensing intact. Run `npm run build` and verify rendered frames offline when changing art. Do not claim the art is approved."
  }
}
